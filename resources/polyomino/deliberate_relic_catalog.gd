@tool
extends RefCounted
class_name DeliberateRelicCatalog
## Registry of deliberate pinball relics (TASK-093 / TASK-094).
## 7 Core Archetypes x 3 Tiers x 2 Variations = 42 Deliberate Relics.

const PolyominoModuleData = preload("res://resources/polyomino/polyomino_module_data.gd")

const CellType = PolyominoModuleData.CellType
const GoalArchetype = PolyominoModuleData.GoalArchetype
const RewardType = PolyominoModuleData.RewardType
const EnclosureType = PolyominoModuleData.EnclosureType
const MachineryLayoutMode = PolyominoModuleData.MachineryLayoutMode

static var _CATALOG: Dictionary = {}
static var _GOALS: Dictionary = {}

static func get_catalog() -> Dictionary:
	if not _CATALOG.is_empty():
		return _CATALOG
	_build_catalog()
	return _CATALOG

static func get_goals() -> Dictionary:
	if not _GOALS.is_empty():
		return _GOALS
	_build_catalog()
	return _GOALS

static func has_relic(id: StringName) -> bool:
	return get_catalog().has(id)

static func get_relic(id: StringName) -> Dictionary:
	return get_catalog().get(id, {})

static func get_goal(id: StringName) -> Dictionary:
	return get_goals().get(id, {})

static func get_all_ids() -> Array[StringName]:
	var ids: Array[StringName] = []
	for k in get_catalog():
		ids.append(k)
	return ids

static func _def(id: StringName, name: String, tier: int, shape: String, m_desc: String, cells: Array[Vector2i], types: Dictionary = {}, dirs: Dictionary = {}, enclosure: int = EnclosureType.OPEN_FRAME, letters: Dictionary = {}, layout_mode: int = MachineryLayoutMode.PER_CELL, unified_type: int = CellType.EMPTY, goal: Dictionary = {}) -> void:
	_CATALOG[id] = {
		"display_name": name, "tier": tier, "shape_name": shape, "machinery_desc": m_desc,
		"cells": cells, "cell_types": types, "cell_directions": dirs, "energy_values": {},
		"cell_letters": letters, "bumper_durability": 0, "enclosure_type": enclosure,
		"custom_wall_edges": {}, "layout_mode": layout_mode, "unified_component_type": unified_type
	}
	if not goal.is_empty():
		_GOALS[id] = goal

static func _build_catalog() -> void:
	_CATALOG.clear()
	_GOALS.clear()
	_build_bumper_vessels()
	_build_word_banks()
	_build_wire_reservoirs()
	_build_detonation_triangles()
	_build_bash_toys()
	_build_spinners()
	_build_momentum_tracks()

