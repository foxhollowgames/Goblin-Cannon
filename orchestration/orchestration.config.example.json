{
  "repoRoot": "..",
  "worktreeParentDir": "..",
  "godotPath": "",
  "cursorCli": {
    "command": "cursor",
    "args": ["agent", "{{PROMPT}}"],
    "timeoutMs": 3600000,
    "exitAfterSummaryIdleMs": 60000,
    "exitAfterOutputIdleMs": 180000,
    "maxExecutionWallMs": 420000,
    "headlessAgent": false,
    "env": {}
  },
  "plannerFallback": true,
  "requireExecutionGitChanges": true,
  "autoMergeOnPass": true,
  "pushAfterMerge": true,
  "gitRemote": "origin",
  "deleteRemoteAgentBranch": true,
  "godotHeadlessTimeoutMs": 600000,
  "godotTestFixRetries": 5,
  "agentModelOptions": [
    "gpt-5",
    "gpt-5.1",
    "gpt-5.2",
    "sonnet-4.5",
    "opus-4.5",
    "composer-1"
  ],
  "limits": {
    "maxParallelWorktrees": 4
  },
  "dryRun": false
}
