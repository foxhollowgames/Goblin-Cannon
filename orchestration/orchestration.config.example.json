{
  "repoRoot": "..",
  "worktreeParentDir": "..",
  "godotPath": "",
  "cursorCli": {
    "command": "cursor",
    "args": ["agent", "{{PROMPT}}"],
    "timeoutMs": 3600000,
    "exitAfterSummaryIdleMs": 60000,
    "exitAfterOutputIdleMs": 180000,
    "maxExecutionWallMs": 420000,
    "headlessAgent": false,
    "env": {}
  },
  "plannerFallback": true,
  "requireExecutionGitChanges": true,
  "autoMergeOnPass": true,
  "pushAfterMerge": true,
  "gitRemote": "origin",
  "deleteRemoteAgentBranch": true,
  "godotHeadlessTimeoutMs": 600000,
  "godotTestFixRetries": -1,
  "executionRecoveryRetries": 2,
  "agentModelOptions": [
    "qwen3-coder-480b-instruct",
    "glm-5.2",
    "devstral-small-2505",
    "qwen-2.5-coder-32b"
  ],
  "limits": {
    "maxParallelWorktrees": 4
  },
  "dryRun": false
}
